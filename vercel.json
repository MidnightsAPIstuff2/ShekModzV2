{
  "rewrites": [
    { "source": "/api/:route*", "destination": "/api/index.js?route=:route*" },
    { "source": "/mod/:id", "destination": "/mod/index.html" },
    { "source": "/u/:name", "destination": "/u/index.html" },
    { "source": "/p/:slug", "destination": "/api/index.js?route=p/:slug" }
  ]
}
